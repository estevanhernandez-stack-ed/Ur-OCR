<Window x:Class="RoRoRo.UrOcr.UI.DangerousKeybindDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm keybind" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16" MinWidth="360">
        <TextBlock x:Name="Body" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Confirm" Width="100" Margin="0,0,6,0" Click="OnConfirm" IsDefault="True"/>
            <Button Content="Pick different" Width="120" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
