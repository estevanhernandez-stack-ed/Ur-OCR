<UserControl x:Class="RoRoRo.UrOcr.UI.TriggerEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RoRoRo.UrOcr.UI">
    <ScrollViewer>
        <StackPanel Margin="20,16,20,20">

            <TextBlock Text="NAME"
                       Style="{StaticResource MetaLabel}"
                       Margin="0,0,0,4" />
            <TextBox Text="{Binding Source.Name, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <CheckBox Content="Enabled"
                          IsChecked="{Binding Enabled}"
                          Margin="0,0,20,0" />
                <CheckBox Content="Account-aware"
                          IsChecked="{Binding Source.AccountAware}" />
            </StackPanel>

            <TextBlock Text="REGION"
                       Style="{StaticResource MetaLabel}"
                       Margin="0,0,0,4" />
            <TextBlock Text="{Binding Source.Region}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="11"
                       Margin="0,0,0,6" />
            <Button Content="Re-pick region"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding RepickRegionCommand}"
                    Padding="10,6"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,16" />

            <!-- ACTION selector -->
            <TextBlock Text="ACTION"
                       Style="{StaticResource MetaLabel}"
                       Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton Content="Press keybind"
                             IsChecked="{Binding IsKeyChord, Mode=TwoWay}"
                             Margin="0,0,16,0" />
                <RadioButton Content="Run Ur Task macro"
                             IsChecked="{Binding IsRunMacro, Mode=TwoWay}" />
            </StackPanel>

            <!-- Keybind capture — shown only when KeyChord action -->
            <local:KeybindCapture Combo="{Binding Source.Keybind, Mode=TwoWay}"
                                  Margin="0,0,0,16"
                                  Visibility="{Binding IsKeyChord, Converter={StaticResource BoolToVis}}" />

            <!-- Macro picker — shown only when RunMacro action -->
            <StackPanel Margin="0,0,0,16"
                        Visibility="{Binding IsRunMacro, Converter={StaticResource BoolToVis}}">
                <ComboBox ItemsSource="{Binding UrTaskMacros}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding MacroId, Mode=TwoWay}" />
                <StackPanel Margin="0,6,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UrTaskMacros.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="No Ur Task macros found — record one in Ur Task."
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding MacroSourceHint}"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="9"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="COOLDOWN — DELAY BETWEEN FIRES (MS)"
                       Style="{StaticResource MetaLabel}"
                       Margin="0,0,0,4" />
            <TextBox Text="{Binding Source.CooldownMs}"
                     Margin="0,0,0,2" />
            <TextBlock Text="Minimum wait before this trigger can fire again. Raise it to slow the trigger down."
                       FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <!-- Live match meter (color triggers only) -->
            <TextBlock Text="LIVE MATCH METER"
                       Style="{StaticResource MetaLabel}"
                       Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <!-- Target color swatch -->
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Target"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               Margin="0,0,0,4" />
                    <Border Width="32" Height="32"
                            CornerRadius="4"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="1"
                            Background="{Binding PreviewTargetBrush}" />
                </StackPanel>

                <!-- Sampled color swatch -->
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Sampled"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               Margin="0,0,0,4" />
                    <Border Width="32" Height="32"
                            CornerRadius="4"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="1"
                            Background="{Binding PreviewSampledBrush}" />
                </StackPanel>

                <!-- Distance text + match indicator -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PreviewDistanceText}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="13"
                               Foreground="{StaticResource WhiteBrush}"
                               Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#CC3333" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewIsMatch}" Value="True">
                                            <Setter Property="Fill" Value="#33CC66" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="no match" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewIsMatch}" Value="True">
                                            <Setter Property="Text" Value="match" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
