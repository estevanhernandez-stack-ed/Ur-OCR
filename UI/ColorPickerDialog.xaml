<Window x:Class="RoRoRo.UrOcr.UI.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick target color" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="16" MaxWidth="800">
        <TextBlock Text="Click a pixel in the captured region to set the target color." Margin="0,0,0,8" FontWeight="Bold"/>
        <Border BorderBrush="#888" BorderThickness="1" Margin="0,0,0,8" HorizontalAlignment="Left">
            <Image x:Name="PreviewImage" Stretch="None" Cursor="Cross" MouseLeftButtonDown="OnImageClick" MaxWidth="760" MaxHeight="400"/>
        </Border>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Rectangle x:Name="ColorSwatch" Width="64" Height="64" Fill="White" Stroke="#888" StrokeThickness="1" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="SelectedRgbLabel" Text="Click an image pixel..." FontWeight="Bold"/>
                <TextBlock Margin="0,8,0,2">Tolerance: <Run x:Name="ToleranceValue" Text="15"/></TextBlock>
                <Slider x:Name="ToleranceSlider" Minimum="0" Maximum="100" Value="15" Width="240" HorizontalAlignment="Left" ValueChanged="OnToleranceChanged"/>
            </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Use this color" Width="120" Margin="0,0,6,0" Click="OnOk" IsDefault="True" IsEnabled="False" x:Name="OkButton"/>
            <Button Content="Cancel" Width="80" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
