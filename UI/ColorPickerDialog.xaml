<Window x:Class="RoRoRo.UrOcr.UI.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick target color"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="20" MaxWidth="820">

        <TextBlock Text="PICK A PIXEL"
                   Style="{StaticResource MetaLabel}"
                   Margin="0,0,0,8" />
        <TextBlock Text="Click a pixel in the captured region to set the target color."
                   FontSize="12"
                   Foreground="{StaticResource MutedTextBrush}"
                   Margin="0,0,0,12" />

        <Border BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Margin="0,0,0,12"
                HorizontalAlignment="Left">
            <Image x:Name="PreviewImage"
                   Stretch="None"
                   Cursor="Cross"
                   MouseLeftButtonDown="OnImageClick"
                   MaxWidth="780"
                   MaxHeight="400" />
        </Border>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Width="64" Height="64"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,14,0">
                <Rectangle x:Name="ColorSwatch" Fill="White" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="SelectedRgbLabel"
                           Text="Click an image pixel..."
                           FontWeight="SemiBold"
                           FontSize="13"
                           Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource MetaLabel}" Margin="0,0,0,4">
                    TOLERANCE: <Run x:Name="ToleranceValue" Text="15" Foreground="{StaticResource CyanBrush}" />
                </TextBlock>
                <Slider x:Name="ToleranceSlider"
                        Minimum="0"
                        Maximum="100"
                        Value="15"
                        Width="240"
                        HorizontalAlignment="Left"
                        ValueChanged="OnToleranceChanged" />
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Width="90"
                    Margin="0,0,8,0"
                    Click="OnCancel"
                    IsCancel="True" />
            <Button Content="Use this color"
                    Style="{StaticResource PrimaryButton}"
                    Width="120"
                    Click="OnOk"
                    IsDefault="True"
                    IsEnabled="False"
                    x:Name="OkButton" />
        </StackPanel>

    </StackPanel>
</Window>
