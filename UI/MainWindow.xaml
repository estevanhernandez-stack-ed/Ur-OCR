<Window x:Class="RoRoRo.UrOcr.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RoRoRo.UrOcr.UI"
        Title="RoRoRo Ur OCR" Height="640" Width="900">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#222" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusText}" Foreground="LightGreen" FontWeight="Bold" Margin="0,0,20,0"/>
                <Button Content="Pause all (F9)" Command="{Binding TogglePauseCommand}" Padding="6,3" Margin="0,0,10,0"/>
                <Button Content="+ Add trigger" Command="{Binding AddTriggerCommand}" Padding="6,3"/>
                <Button Content="Settings" Click="OnSettings" Padding="6,3" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>
        <local:DegradedBanner DockPanel.Dock="Top" x:Name="Banner"/>
        <local:ActivityPanel DockPanel.Dock="Bottom" x:Name="Activity"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox Grid.Column="0" ItemsSource="{Binding Triggers}" SelectedItem="{Binding Selected}"
                     SelectionMode="Extended" Margin="6">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding Enabled}" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding HitSummary}" FontSize="11" Foreground="#666"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ContentControl Grid.Column="1" Content="{Binding Selected}" Margin="6">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <local:TriggerEditView/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>
    </DockPanel>
</Window>
