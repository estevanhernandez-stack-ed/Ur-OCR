<Window x:Class="RoRoRo.UrOcr.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RoRoRo.UrOcr.UI"
        Title="RoRoRo Ur OCR"
        Width="960" Height="660"
        MinWidth="760" MinHeight="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />   <!-- titlebar -->
                <RowDefinition Height="Auto" /> <!-- degraded banner -->
                <RowDefinition Height="Auto" /> <!-- header strip -->
                <RowDefinition Height="*" />    <!-- main body -->
                <RowDefinition Height="Auto" /> <!-- activity panel -->
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="RORORO UR OCR"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="9"
                               Foreground="{StaticResource CyanBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Stretch">
                    <Button Content="—"
                            Width="38"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource MutedTextBrush}"
                            FontSize="14"
                            Click="OnTitleBarMinimizeClicked" />
                    <Button Content="▢"
                            Width="38"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource MutedTextBrush}"
                            FontSize="11"
                            Click="OnTitleBarMaximizeClicked" />
                    <Button Content="✕"
                            Width="38"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource MutedTextBrush}"
                            FontSize="12"
                            Click="OnTitleBarCloseClicked" />
                </StackPanel>
            </Grid>

            <!-- Degraded banner (amber warning strip — stays amber by design) -->
            <local:DegradedBanner Grid.Row="1" x:Name="Banner" />

            <!-- Header strip: status + action buttons -->
            <Border Grid.Row="2"
                    Background="{StaticResource RowBgBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,1,0,1"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status text with status dot -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource CyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WhiteBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Action buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Pause all (F9)"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,6"
                                Margin="0,0,8,0"
                                Command="{Binding TogglePauseCommand}" />
                        <Button Content="Dry run (don't press keys)"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,6"
                                Margin="0,0,8,0"
                                Command="{Binding ToggleDryRunCommand}" />
                        <Button Content="+ Add trigger"
                                Style="{StaticResource PrimaryButton}"
                                Padding="10,6"
                                Margin="0,0,8,0"
                                Command="{Binding AddTriggerCommand}" />
                        <Button Content="Settings"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,6"
                                Click="OnSettings" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main body: trigger list (left) + edit panel (right) -->
            <Grid Grid.Row="3" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Trigger list -->
                <ListBox Grid.Column="0"
                         ItemsSource="{Binding Triggers}"
                         SelectedItem="{Binding Selected}"
                         SelectionMode="Single"
                         Margin="0"
                         Padding="6">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding HitSummary}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="&#x2715;"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            FontSize="12"
                                            Padding="8,2"
                                            VerticalAlignment="Center"
                                            Cursor="Hand"
                                            ToolTip="Delete this trigger"
                                            Command="{Binding DataContext.DeleteTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Divider -->
                <Border Grid.Column="1"
                        Width="1"
                        Background="{StaticResource DividerBrush}" />

                <!-- Edit panel -->
                <ContentControl Grid.Column="2"
                                Content="{Binding Selected}"
                                Margin="0">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <local:TriggerEditView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>

            <!-- Activity panel (bottom collapsible) -->
            <Border Grid.Row="4"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,1,0,0">
                <local:ActivityPanel x:Name="Activity" />
            </Border>
        </Grid>
    </Border>
</Window>
